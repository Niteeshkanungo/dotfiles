# ~/.zprompt — Modern & detailed 2-line zsh prompt
source "${HOME}/.shared_prompt"

setopt PROMPT_SUBST

# Line 1: User in Directory on Git status (VirtualEnv)
# Line 2: Dynamic status arrow (Green on success, Red on error)
PROMPT=$'\n╭─ %F{cyan}%Bniteeshkanungo%b%f in %F{blue}%B%~%b%f$(prompt_git)$(prompt_venv)\n╰─ %(?.%F{green}.%F{red})❯%f '
export PROMPT
PS1="$PROMPT"
export PS1

PS2="%F{yellow}→%f "
export PS2
