# ~/.private — local-only secrets (NEVER commit this file).
#
# Setup:
#   cp .private.example ~/.private && chmod 600 ~/.private
#   # fill in real values, then: source ~/.private
#
# ~/.zshrc sources ~/.private automatically when present.

