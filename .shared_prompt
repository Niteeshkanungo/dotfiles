# ~/.shared_prompt — Prompt helpers for Git, Python virtualenv, and colors

prompt_git() {
    local git_status=''
    local branchName=''

    # Check if inside a Git repository
    if git rev-parse --is-inside-work-tree &>/dev/null; then
        local gitSummary
        gitSummary=$(git status --porcelain 2>/dev/null)

        # Status flags
        [[ -n $(echo "$gitSummary" | grep '^[MADRC]') ]] && git_status+='%F{green}+%f'
        [[ -n $(echo "$gitSummary" | grep '^.[MD]') ]]    && git_status+='%F{yellow}!%f'
        [[ -n $(echo "$gitSummary" | grep '^\?\?') ]]     && git_status+='%F{red}?%f'
        if git rev-parse --verify refs/stash &>/dev/null; then
            git_status+='%F{cyan}$%f'
        fi

        branchName="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo 'detached')"

        if [[ -z "$git_status" ]]; then
            git_status="%F{green}✔%f"
        fi

        printf " on %%F{magenta}git:(%%B%s%%b)%%f [%s]" "${branchName}" "${git_status}"
    fi
}

export VIRTUAL_ENV_DISABLE_PROMPT=1
prompt_venv() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        local venv_name
        venv_name=$(basename "$VIRTUAL_ENV")
        printf " %%F{cyan}(%s)%%f" "${venv_name}"
    fi
}
